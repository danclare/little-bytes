# Public browser configuration
NEXT_PUBLIC_APP_NAME=Little Bites

# Server-only application settings
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://littlebites:replace-me@localhost:5432/littlebites?schema=public
RATE_LIMIT_HMAC_KEY=replace-with-a-different-random-secret
RESET_TOKEN_TTL_MINUTES=30

# Private child-photo storage. Use either Azure Blob (recommended in Azure)
# or the local private filesystem for development. On Render Free, set
# PHOTO_STORAGE=disabled. Production defaults to disabled when unset.
PHOTO_STORAGE=local
PHOTO_LOCAL_DIRECTORY=./var/private-uploads
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=child-photos

# Apple Sign In remains disabled unless all values are configured.
# Optional Microsoft (Entra ID) sign-in. Leave blank to hide the button.
# ENTRA_TENANT_ID accepts common | organizations | consumers | <tenant GUID>.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/auth/entra/callback when blank.
ENTRA_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# Configure SMTP credentials to enable password-reset delivery.
EMAIL_DELIVERY=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Deployment workflow variables (configured in GitHub, never copied into image)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
