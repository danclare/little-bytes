resource_group_name            = "rg-little-bites-dev"
location                        = "uksouth"
name_prefix                     = "littlebites"
environment                     = "dev"
unique_suffix                   = "abc123"
bootstrap_image                 = "mcr.microsoft.com/k8se/quickstart:latest"
